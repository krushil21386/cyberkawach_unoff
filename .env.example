# ─── Cyber Fraud Guardian — Environment Variables ───
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL — the system degrades gracefully without them.

# ─── Gemini (non-critical — deterministic fallback if unavailable) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Google Safe Browsing (free, non-commercial use) ───
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here

# ─── PhishTank (free, requires registration) ───
PHISHTANK_API_KEY=your_phishtank_api_key_here

# ─── P2 Optional: AbuseIPDB (1,000 checks/day free) ───
# Only used if Phase 4 integration is completed
# ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ─── P2 Optional: URLhaus (free, no key required for lookup) ───
# No API key needed — uses public API. Wired in Phase 4 if time allows.

# ─── Application Settings ───
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=30

# ─── File Upload ───
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp

# ─── Security ───
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Maximum message length to analyze
MAX_MESSAGE_LENGTH=10000
# Maximum URLs to analyze per message
MAX_URLS_PER_MESSAGE=20

# ─── OSINT Enrichment ───
OSINT_ENABLED=true
